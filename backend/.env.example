# Mesma connection string usada pelo Next.js/db/*.mjs hoje (ver .env.local
# na raiz do repo) — aponta pro mesmo Postgres do docker-compose.yml, não
# sobe um banco separado. Formato padrão postgresql://; o backend converte
# pra postgresql+asyncpg:// sozinho (ver app/config.py).
DATABASE_URL=postgresql://comuna:senha@localhost:5432/comuna

# Origens (frontend) que podem chamar essa API pelo navegador — separadas
# por vírgula. Em dev, o Vite roda em 5173 por padrão.
CORS_ORIGINS=http://localhost:5173
