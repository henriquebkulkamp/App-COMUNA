# Mesma connection string usada pelo Next.js/db/*.mjs hoje (ver .env.local
# na raiz do repo) — aponta pro mesmo Postgres do docker-compose.yml, não
# sobe um banco separado. Formato padrão postgresql://; o backend converte
# pra postgresql+asyncpg:// sozinho (ver app/config.py).
DATABASE_URL=postgresql://comuna:senha@localhost:5432/comuna

# Origens (frontend) que podem chamar essa API pelo navegador — separadas
# por vírgula. Em dev, o Vite roda em 5173 por padrão.
CORS_ORIGINS=http://localhost:5173

# Conta admin padrão — criada sozinha na primeira vez que o backend sobe
# com a tabela "admins" vazia (ver app/main.py). Troque a senha depois
# de logar pela primeira vez pelo painel.
ADMIN_EMAIL=admin@comuna.local
ADMIN_SENHA=comuna123

# Assina os tokens de sessão do login admin (ver app/auth.py) — gere uma
# chave de verdade em produção, ex: `openssl rand -hex 32`. Qualquer um
# que conheça essa chave consegue forjar um token de admin.
AUTH_SECRET_KEY=troque-esta-chave-em-producao
