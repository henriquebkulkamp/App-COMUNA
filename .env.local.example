# ============================================================
# CREDENCIAIS DO POSTGRES — COPIE ESTE ARQUIVO PARA .env.local
# NUNCA commite o .env.local no git!
# ============================================================

# Usadas pelo docker-compose.yml para subir o container local
# (npm run db:up). Escolha uma senha forte.
POSTGRES_USER=comuna
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=comuna
POSTGRES_PORT=5432

# String de conexão usada pelo app (lib/db.ts) e pelos scripts em db/*.mjs.
# Local (docker compose): postgresql://USUARIO:SENHA@localhost:5432/BANCO
# Produção (Postgres na nuvem — Neon/Supabase/Vercel Postgres): use a
# connection string fornecida pelo provedor, geralmente com "?sslmode=require".
DATABASE_URL=postgresql://comuna:troque-esta-senha@localhost:5432/comuna
