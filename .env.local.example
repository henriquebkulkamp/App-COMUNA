# ============================================================
# CREDENCIAIS DO GOOGLE SHEETS — COPIE ESTE ARQUIVO PARA .env.local
# NUNCA commite o .env.local no git!
# ============================================================

# ID da planilha — parte da URL entre /d/ e /edit
# Ex: https://docs.google.com/spreadsheets/d/SEU_ID_AQUI/edit
GOOGLE_SHEET_ID=SEU_ID_AQUI

# Email da Service Account gerada no Google Cloud Console
# Ex: comuna-sheets-bot@seu-projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=SEU_EMAIL_DE_SERVICE_ACCOUNT@seu-projeto.iam.gserviceaccount.com

# Chave privada do JSON baixado — copie o valor do campo "private_key"
# Inclua as aspas e mantenha os \n literais (não quebre em linhas)
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END RSA PRIVATE KEY-----\n"
